NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (Auth magic-link redirects). Local: http://localhost:3000
# Production (Vercel): MUST be https://grygielgitaraweb.vercel.app — NOT localhost
# Also in Supabase → Authentication → URL Configuration:
#   Site URL = production URL
#   Redirect URLs = https://grygielgitaraweb.vercel.app/**  and http://localhost:3000/**
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Ads gtag (public). From Ads → conversion tag setup (AW-...).
# Also set in Vercel → Environment Variables for production.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-xxxxxxxxxx
# Conversion label (Ads → Konwersje → Kontakt → event snippet, after /)
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=xxxxxxxxxx

# Resend (transactional email + PDF bonus after contact form)
# Production: verify domain in Resend → Domains, then e.g.
# RESEND_FROM_EMAIL=GrygielGitara <kontakt@grygielgitara.pl>
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=GrygielGitara <onboarding@resend.dev>
CONTACT_TO_EMAIL=twoj@email.pl

# Auth confirmation / password-reset mails (Supabase → Resend SMTP from your domain):
# 1) Resend → Domains: grygielgitara.pl verified
# 2) Supabase → Authentication → Emails → SMTP Settings → Enable Custom SMTP
#    Host: smtp.resend.com
#    Port: 465
#    Username: resend
#    Password: (same RESEND_API_KEY)
#    Sender email: kontakt@grygielgitara.pl
#    Sender name: GrygielGitara
# 3) Optional: Authentication → Email Templates — Polish copy + brand name
# Until SMTP is set, Supabase sends from noreply@mail.app.supabase.io (UI warns users).

# Brevo (free marketing contact list sync)
# API key: Brevo → SMTP & API → API keys
# List ID: Contacts → Lists → open list → ID in URL / settings
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_LIST_ID=2

# Simple password gate for /admin (not Supabase Auth yet)
ADMIN_PASSWORD=zmien-na-mocne-haslo

# Optional Brevo SMS sender name (max ~11 chars, must be allowed in Brevo)
BREVO_SMS_SENDER=Grygiel

# Day-before lesson reminders (Vercel Cron → /api/cron/lesson-reminders @ 10:00 UTC ≈ 12 PL)
# Same value in Vercel env. Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=zmien-na-dlugi-losowy-sekret

# Optional: SMS reminder also to you at noon day-before (needs Brevo SMS)
# TEACHER_PHONE=+48123456789

# Public Stripe checkout. false = catalog visible, CTA = zapis + zniżka (no buy).
# Set to true when ready to sell — products/admin grants stay intact either way.
SHOP_SALES_OPEN=false

# Free PDF. false = teaser stays, CTA „Już wkrótce dostępny”. true = download form.
FREE_GUIDE_OPEN=false

# Stripe (shop checkout + webhook)
# Dashboard → Developers → API keys / Webhooks
# Webhook endpoint: https://YOUR_DOMAIN/api/webhooks/stripe
# Events: checkout.session.completed
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Optional publishable key if you add client Stripe.js later
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
